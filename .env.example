# Piercer 本地配置模板（复制为 .env.local 使用，真实值绝不提交）
# cp .env.example .env.local

# 公网服务器 IP（信令 + STUN/TURN）
PIERCER_PUBLIC_IP=YOUR_SERVER_IP

# 信令地址（可选，不填则按 PUBLIC_IP 自动拼接 ws://<IP>:8080/ws）
#PIERCER_SIGNAL_ADDR=ws://YOUR_SERVER_IP:8080/ws
# 兼容旧变量名：
#SIGNAL_ADDR=ws://YOUR_SERVER_IP:8080/ws

# STUN/TURN 端口
PIERCER_STUN_PORT=3478
PIERCER_TURN_PORT=3478

# TURN 账号（中继默认关闭；设置强密码才启用，生成示例：openssl rand -base64 24）
PIERCER_TURN_USER=piercer
PIERCER_TURN_PASS=CHANGE_ME_SET_STRONG_PASSWORD

# 服务端共享目录
SHARED_DIR=./shared
